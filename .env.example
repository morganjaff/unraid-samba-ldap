# Copier ce fichier en .env et adapter les valeurs avant docker compose up.

# --- OpenLDAP ---
LDAP_ORGANISATION=Home Lab
LDAP_DOMAIN=home.lan
LDAP_BASE_DN=dc=home,dc=lan
LDAP_ADMIN_PASSWORD=changeme-admin
LDAP_CONFIG_PASSWORD=changeme-config

# --- Bind utilisé par nslcd et Samba (ici : l'admin LDAP, simplification homelab) ---
LDAP_BIND_DN=cn=admin,dc=home,dc=lan

# --- Structure de l'annuaire ---
LDAP_PEOPLE_OU=ou=people
LDAP_GROUP_OU=ou=groups

# --- Samba ---
SAMBA_WORKGROUP=WORKGROUP
SAMBA_NETBIOS_NAME=UNRAID-SAMBA
SAMBA_SERVER_STRING=Unraid LDAP Samba

# --- LDAP Account Manager ---
LAM_LANG=fr_FR.UTF-8
# Mot de passe maître LAM (première initialisation uniquement)
LAM_PASSWORD=changeme-lam
