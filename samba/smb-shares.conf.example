# Exemple de définitions de partages, à copier vers smb-shares.conf
# (monté en volume depuis l'appdata Unraid, éditable sans reconstruire l'image).
#
# Rappel : pour que les permissions par utilisateur fonctionnent réellement,
# les uidNumber/gidNumber LDAP doivent correspondre aux propriétaires réels
# des fichiers sur le disque (voir README, section "Alignement UID/GID").

[family]
   path = /mnt/user/family
   valid users = @family
   write list = @family
   read only = no
   browseable = yes
   create mask = 0664
   directory mask = 0775

[photos]
   path = /mnt/user/photos
   valid users = @family
   write list = @family_admins
   read only = yes
   browseable = yes
   create mask = 0664
   directory mask = 0775

# Dossier personnel par utilisateur, créé automatiquement à la première connexion.
# "root preexec" s'exécute en root à l'ouverture du partage : le dossier est créé
# (une seule fois) avec pour propriétaire le uidNumber/gidNumber LDAP de l'utilisateur,
# sans manipulation côté Unraid. Un dossier déjà existant n'est jamais modifié.
# Chemins vus depuis le conteneur : avec le template Unraid, /mnt/user correspond
# à /mnt/user/users sur l'hôte (volume « Shares Unraid »).
[homes]
   path = /mnt/user/%S
   root preexec = /bin/sh -c 'd="/mnt/user/%U"; [ -e "$d" ] || { mkdir -p "$d" && chown %U: "$d" && chmod 700 "$d"; }'
   valid users = %S
   read only = no
   browseable = no
   create mask = 0600
   directory mask = 0700
