# Structure de base de l'annuaire, chargée automatiquement au premier
# démarrage par osixia/openldap (substitution {{ LDAP_BASE_DN }} gérée
# nativement par l'image, cf. sa documentation "bootstrap ldif").

dn: ou=people,{{ LDAP_BASE_DN }}
objectClass: organizationalUnit
ou: people

dn: ou=groups,{{ LDAP_BASE_DN }}
objectClass: organizationalUnit
ou: groups
