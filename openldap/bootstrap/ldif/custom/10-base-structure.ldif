# Structure de base de l'annuaire (entrées "add" pures, chargées via ldapadd).
# La substitution {{ LDAP_BASE_DN }} est gérée par l'image osixia/openldap.

dn: ou=people,{{ LDAP_BASE_DN }}
objectClass: organizationalUnit
ou: people

dn: ou=groups,{{ LDAP_BASE_DN }}
objectClass: organizationalUnit
ou: groups
