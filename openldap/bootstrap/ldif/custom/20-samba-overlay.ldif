# Overlay smbk5pwd : génère sambaNTPassword lors d'un changement de mot de passe
# via l'opération étendue "Password Modify" (ldappasswd, clients LDAP qui l'utilisent).
# Vérifié sur osixia/openldap:1.5.0 : cn=module{0} et olcDatabase={1}mdb existent.

dn: cn=module{0},cn=config
changetype: modify
add: olcModuleLoad
olcModuleLoad: smbk5pwd.so

dn: olcOverlay=smbk5pwd,olcDatabase={1}mdb,cn=config
changetype: add
objectClass: olcOverlayConfig
objectClass: olcSmbK5PwdConfig
olcOverlay: smbk5pwd
olcSmbK5PwdEnable: samba
